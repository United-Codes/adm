list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry code (
        label: How It Works: The Code
        icon {
            imageIconCssClasses: fa-code
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry overview (
        label: Overview
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry queue (
        label: Queue & Outbox
        icon {
            imageIconCssClasses: fa-inbox
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry results (
        label: Workflow Results
        icon {
            imageIconCssClasses: fa-check-circle-o
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry upload (
        label: Upload & Create
        icon {
            imageIconCssClasses: fa-upload
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry workflows (
        label: Workflows & Rules
        icon {
            imageIconCssClasses: fa-sliders
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 5
            }
        }
    )

)

