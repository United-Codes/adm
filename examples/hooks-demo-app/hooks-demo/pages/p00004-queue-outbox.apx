            }
            source {
                primaryKey: true
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column MSG_STATE (
            type: plainText
            heading {
                heading: State
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column OBJECT_ID (
            type: plainText
            heading {
                heading: Document / Folder id
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column QUEUE_NAME (
            type: plainText
            heading {
                heading: Queue
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
                availableOnClient: true
            }
            advanced {
                endUserAlias: A
            }
        )

        column RETRY_COUNT (
            type: plainText
            heading {
                heading: Retries
            }
            layout {
