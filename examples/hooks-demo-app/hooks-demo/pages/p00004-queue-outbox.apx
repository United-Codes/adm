    button process-now (
        buttonName: PROCESS_NOW
        label: Process queue now
        layout {
            sequence: 20
            region: @queue
            slot: copy
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-play
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 10
            region: @queue
            slot: copy
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction process-queue-now (
        name: Process queue now
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @process-now
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                        hkd_demo_api.process_now;
                    end;
                    ```
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-outbox (
            action: refresh
            affectedElements {
                selectionType: region
                region: @outbox
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-queue (
            action: refresh
            affectedElements {
                selectionType: region
                region: @queue
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-all (
        name: Refresh
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh-outbox (
            action: refresh
            affectedElements {
                selectionType: region
                region: @outbox
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-queue (
            action: refresh
            affectedElements {
                selectionType: region
                region: @queue
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-refused (
            action: refresh
            affectedElements {
                selectionType: region
                region: @refused
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

)

