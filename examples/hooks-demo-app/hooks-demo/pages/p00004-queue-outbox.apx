                heading: Enqueued
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: SINCE
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column HOOK_KEY (
            type: plainText
            heading {
                heading: Event
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column MSG_ID (
            type: plainText
            heading {
                heading: Message id
            }
            layout {
